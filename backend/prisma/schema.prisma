generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  GUEST
  STAFF
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("GUEST")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

